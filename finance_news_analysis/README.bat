@echo off
chcp 65001 >nul
REM ============================================================
REM  股市新闻系统 - 使用说明
REM ============================================================
echo.
echo   ============================================
echo     股市新闻推送与分析系统 - 使用说明
echo   ============================================
echo.
echo   【日常使用】
echo     1. 每天早上 8:00 系统会自动采集和分析新闻
echo        （电脑需开机，无需人工操作）
echo.
echo   【查看新闻看板】
echo     双击 start_web.bat 启动网页看板
echo     浏览器访问 http://127.0.0.1:5000
echo     看完后关闭命令行窗口即可停止服务器
echo.
echo   【手动刷新数据】
echo     方式1: 在网页看板中点击右上角"刷新数据"按钮
echo     方式2: 双击 run_daily.bat 手动触发采集+分析
echo.
echo   【修改定时时间】
echo     打开"任务计划程序"(Win+R输入 taskschd.msc)
echo     找到 StockNewsDaily 任务，右键"属性"修改触发器时间
echo.
echo   【暂停/删除定时任务】
echo     暂停: 在任务计划程序中右键"禁用"
echo     删除: 在任务计划程序中右键"删除"
echo     或运行: schtasks /Delete /TN "StockNewsDaily" /F
echo.
echo   ============================================
echo.
pause